{
  "name": "moral-compass",
  "version": "1.0.1",
  "description": "Brújula moral para organizar tu día",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.mark.moralcompass",
    "productName": "Moral Compass",
    "copyright": "Copyright © 2025 Matias Rosas",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "icon": "front/assets/moralcompass_icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^37.2.4",
    "electron-builder": "^26.0.0"
  }
}
